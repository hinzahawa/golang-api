name: CI

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # 1. ดึงโค้ดล่าสุดจาก GitHub มา
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. ติดตั้งภาษา Go บน GitHub Runner
      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: '1.23'

      # 3. โหลด Dependencies
      - name: Install dependencies
        run: go mod download

      # 4. รันเทส (ถ้ามี)
      - name: Run tests
        run: go test -v ./...

      # 5. ลอง Build โค้ดดูว่าผ่านไหม
      - name: Build Go binary
        run: go build -o main .

      # 6. ลอง Build Docker Image ดูว่าผ่านไหม
      - name: Build Docker image
        run: docker build -t my-go-app .